<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <Color x:Key="BackgroundLight">#F3F6F5</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceAltLight">#E9F0EE</Color>
    <Color x:Key="StrokeLight">#D3DFDC</Color>
    <Color x:Key="TextLight">#10201D</Color>
    <Color x:Key="TextMutedLight">#56685F</Color>
    <Color x:Key="PrimaryLight">#0F766E</Color>
    <Color x:Key="PrimaryHoverLight">#0B5F58</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="PrimarySoftLight">#D5F2EE</Color>
    <Color x:Key="AccentLight">#D97706</Color>
    <Color x:Key="AccentSoftLight">#FDEFD3</Color>
    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerSoftLight">#FDE3E3</Color>
    <Color x:Key="IndigoLight">#4F46E5</Color>
    <Color x:Key="IndigoSoftLight">#E3E2FC</Color>
    <Color x:Key="RoseLight">#BE185D</Color>
    <Color x:Key="RoseSoftLight">#FBE1EC</Color>
    <Color x:Key="DisabledLight">#C9D3D0</Color>

    <Color x:Key="BackgroundDark">#0B1412</Color>
    <Color x:Key="SurfaceDark">#12201D</Color>
    <Color x:Key="SurfaceAltDark">#1A2C28</Color>
    <Color x:Key="StrokeDark">#26423C</Color>
    <Color x:Key="TextDark">#E8F2EF</Color>
    <Color x:Key="TextMutedDark">#9AB1AB</Color>
    <Color x:Key="PrimaryDark">#2DD4BF</Color>
    <Color x:Key="PrimaryHoverDark">#5EEAD4</Color>
    <Color x:Key="OnPrimaryDark">#04201C</Color>
    <Color x:Key="PrimarySoftDark">#123B35</Color>
    <Color x:Key="AccentDark">#FBBF24</Color>
    <Color x:Key="AccentSoftDark">#3A2E0E</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="DangerSoftDark">#3B1616</Color>
    <Color x:Key="IndigoDark">#A5B4FC</Color>
    <Color x:Key="IndigoSoftDark">#23264A</Color>
    <Color x:Key="RoseDark">#F9A8D4</Color>
    <Color x:Key="RoseSoftDark">#3D1A2C</Color>
    <Color x:Key="DisabledDark">#2E3F3B</Color>

    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>

</ResourceDictionary>
